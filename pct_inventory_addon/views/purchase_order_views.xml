<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================== -->
        <!-- PURCHASE ORDER LIST VIEW - SHOW STATUS COLUMNS -->
        <!-- ============================================== -->

        <!-- Show invoice_status (Bill Status) by default on PO list view -->
        <record id="view_purchase_order_tree_invoice_status" model="ir.ui.view">
            <field name="name">purchase.order.list.invoice.status.show</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <field name="invoice_status" position="attributes">
                    <attribute name="optional">show</attribute>
                </field>
            </field>
        </record>

        <!-- Show receipt_status by default on PO list view -->
        <record id="view_purchase_order_tree_receipt_status" model="ir.ui.view">
            <field name="name">purchase.order.list.receipt.status.show</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_stock.purchase_order_view_tree_inherit"/>
            <field name="arch" type="xml">
                <field name="receipt_status" position="attributes">
                    <attribute name="optional">show</attribute>
                </field>
            </field>
        </record>

    </data>
</odoo>
